{
  "name": "justtag-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "abi": "node scripts/export-abi.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build": "tsc -p . && npm run build:web",
    "start": "node dist/index.js",
    "dev": "npm run abi && npm run build:web && tsx watch src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "serve": "tsx src/index.ts",
    "e2e:fork": "tsx test/e2e-fork.ts",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "sharp": "^0.35.5",
    "viem": "^2.58.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
